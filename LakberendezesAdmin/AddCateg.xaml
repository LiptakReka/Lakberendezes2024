<Window x:Class="LakberendezesAdmin.AddCateg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LakberendezesAdmin"
        mc:Ignorable="d"
        Title="Új szoba" Height="200" Width="300" Background="#FADADD">
    <Grid Margin="20" >
        <StackPanel Background="#F9E0D9">
            <TextBlock Text="Helység neve: " FontWeight="Bold"  Width="100"/>
            <TextBox x:Name="RoomNameTextBox" Width="250" Height="30" Margin="0,5"/>

            <Button Content="Mentés" Width="100" Height="30"

                 Margin="0,10,0,0" Background="#FFDAB9" Foreground="black" Click="save_Click"

                 />
        </StackPanel>
    </Grid>
</Window>
