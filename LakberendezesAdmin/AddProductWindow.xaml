<Window x:Class="LakberendezesAdmin.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LakberendezesAdmin"
        mc:Ignorable="d"
        Title="Új termék felvitele" Height="570" Width="450">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Termék neve: " FontWeight="Bold"/>
            <TextBox x:Name="ProductNameTextBox" Width="250" Height="30" Margin="0,5"/>
            <TextBlock Text="Ár: (HUF)" FontWeight="Bold"/>
            <TextBox x:Name="ProductPriceTextBox" Width="250" Height="30" Margin="0,5"/>
            <TextBlock Text="Shop Url: " FontWeight="Bold"/>
            <TextBox x:Name="ProductUrlTextBox" Width="250" Height="30" Margin="0,5"/>
            <TextBlock Text="Kép Url: " FontWeight="Bold"/>
            <TextBox x:Name="ProductimgTextBox" Width="250" Height="30" Margin="0,5"/>
            <TextBlock Text="Shopid: " FontWeight="Bold"/>
            <TextBox x:Name="ProductshIdTextBox" Width="250" Height="30" Margin="0,5"/>
            <TextBlock Text="Típus: " FontWeight="Bold"/>
            <TextBox x:Name="ProducttypeTextBox" Width="250" Height="30" Margin="0,5"/>
            <TextBlock Text="Kategória: " FontWeight="Bold"/>
            <TextBox x:Name="ProductroomTextBox" Width="250" Height="30" Margin="0,5"/>
            <Button Content="Mentés" Width="100" Height="30"
                    Margin="0,10,0,0" Background="Green" Foreground="White" Click="Button_Click"
                    />
        </StackPanel>
    </Grid>
</Window>
