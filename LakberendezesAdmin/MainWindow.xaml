<Window x:Class="LakberendezesAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LakberendezesAdmin"
        mc:Ignorable="d"
        Title="AdminPanel" Height="600" Width="900"
        Icon="assets/hatter.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#f0f0f0">
    <Window.Resources>
        <Style x:Key="SideMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        Cursor="{TemplateBinding Cursor}">
                            <ContentPresenter HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34495E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1ABC9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="99"/>
            <ColumnDefinition Width="101"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Background="#4A1942 " Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="Admin Panel"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="10"/>
            <Separator Background="#34495E" Height="2"/>
            <Button Content="Felhasználók"
                    Click="Users_Click"
                    Style="{StaticResource SideMenuButtonStyle}"/>
            <Button Content="Termékek"
                    Click="Products_Click"
                    Style="{StaticResource SideMenuButtonStyle}"/>
            <Button Content="Mentett Tervek"
                    Click="Plans_Click"
                    Style="{StaticResource SideMenuButtonStyle}"/>
            <Button Content="Boltok" Click="Shops_Click" 
                    Style="{StaticResource SideMenuButtonStyle}"/>
            <Button Content="Bútortípusok" 
                    Click="FurnitureTypes_Click" 
                    Style="{StaticResource SideMenuButtonStyle}"/>
            <Button Content="Szobák"
                    Click="Rooms_Click"
                    Style="{StaticResource SideMenuButtonStyle}"/>
            <Button Content="Kijelentkezés"
                    Click="Logout_Click"
                    Style="{StaticResource SideMenuButtonStyle}" Margin="10,200,10,10" BorderThickness="1" BorderBrush="Black"/>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Column="2" NavigationUIVisibility="Hidden"/>
    </Grid>

</Window>
