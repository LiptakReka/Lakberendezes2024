<Page x:Class="LakberendezesAdmin.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LakberendezesAdmin.Pages"
      xmlns:converters="clr-namespace:LakberendezesAdmin.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Termékek">
    <Page.Resources>
        <converters:ShopIdToName x:Key="ShopIdToNameConverter"/>
        <converters:ProductTypeToName x:Key="ProductTypeToNameConverter"/>
        <converters:CategToName x:Key="CategToNameConverter"/>
        <DropShadowEffect x:Key="MaterialShadow" 
                    BlurRadius="12"
                    ShadowDepth="4"
                    Color="Black"
                    Direction="270"
                    Opacity="0.4"/>
    </Page.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F9E0D9"
            Padding="20" Margin="0,0,0,10"
            Effect="{StaticResource MaterialShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                        Text="Termékek"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#463F1A"
                        VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                    <TextBox Width="300"
                         Name="SearchTextBox"
                         Height="36"
                         Padding="10,5"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         BorderBrush="#DDD"
                         BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Content="Keresés"
                        Width="100"
                        Height="36"
                        Background="#C0E6DE"
                        Foreground="#463F1A"
                        BorderThickness="0"
                        Click="Button_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Export"
                        Width="100"
                        Height="36"
                        Background="#C0E6DE"
                        Foreground="#463F1A"
                        BorderThickness="0"
                        Click="Button_Click_2">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <Button Grid.Column="2"
                    Content="Új termék"
                    Width="120"
                    Height="40"
                    Background="#EAF7CF"
                    Foreground="#463F1A"
                    BorderThickness="0"
                    Click="Button_Click_1">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="1"
            Background="White"
            CornerRadius="8"
            Padding="20"
            Margin="20" Effect="{StaticResource MaterialShadow}">
            <DataGrid x:Name="ProductsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  RowBackground="White"
                  AlternatingRowBackground="#f9f9f9"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                    SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9E0D9"/>
                        <Setter Property="Foreground" Value="#463F1A"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#DDD"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="50"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azonosító" Binding="{Binding id}"/>
                    <DataGridTextColumn Header="Név" Binding="{Binding name}"/>
                    <DataGridTextColumn Header="Ár" Binding="{Binding price}"/>
                    <DataGridTextColumn Header="Vásárlási link" Binding="{Binding shoplink}"/>
                    <DataGridTextColumn Header="Kép" Binding="{Binding imageurl}"/>
                    <DataGridTextColumn Header="Webáruház" Binding="{Binding shopid, Converter={StaticResource ShopIdToNameConverter}}"/>
                    <DataGridTextColumn Header="Bútor típusa" Binding="{Binding product_type_id, Converter={StaticResource ProductTypeToNameConverter}}"/>
                    <DataGridTextColumn Header="Szoba" Binding="{Binding roomid, Converter={StaticResource CategToNameConverter}}"/>
                    <DataGridTemplateColumn Header="Műveletek" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Törlés"
                                    Width="80"
                                    Height="30"
                                    Background="#FFD6D6"
                                    Foreground="#333"
                                    BorderThickness="0"
                                    Click="DeleteButton_Click"
                                    Tag="{Binding id}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="15"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
