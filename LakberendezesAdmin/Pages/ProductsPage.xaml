<Page x:Class="LakberendezesAdmin.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LakberendezesAdmin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Termékek">

    <Grid>

        <Border Background="#F9E0D9" CornerRadius="10" Padding="20" BorderBrush="#d0d0d0" BorderThickness="1" >
            <StackPanel>
                <TextBlock Text="Termékek"
                           FontSize="26"
                           FontWeight="Bold"
                           
                           Foreground="#FF333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="SearchTextBox" Width="300" Height="30" Padding="5"/>
                    <Button Content="Keresés" Width="100" Height="30" Margin="10,0,0,0" Background="#C0E6DE" Click="Button_Click" />
                    <ListBox x:Name="PorductsListBox" Width="170" Height="60" DisplayMemberPath="name" SelectionMode="Single"/>
                    
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid x:Name="ProductsGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              Background="#BB999C"
                              GridLinesVisibility="None"
                              BorderBrush="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#f4f4f4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MaxHeight="600"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True">
                    </DataGrid>
                </ScrollViewer>
                <Button Content="Új termék" Width="100" Margin="-280,20,0,0" Height="40" Background="#C0E6DE" Foreground="Black" Padding="5" Click="Button_Click_1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                            CornerRadius="20" 
                            Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Export" Width="100" Margin="-10,-38,0,0" Height="40" Background="#C0E6DE" Foreground="Black" Padding="5" Click="Button_Click_2">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                            CornerRadius="20" 
                            Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Törlés" Width="100" Margin="265,-38,0,0" Height="40" Background="#C0E6DE" Foreground="Black" Padding="5" Click="DeleteButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                      CornerRadius="20" 
                                       Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>
