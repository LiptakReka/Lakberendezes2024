<Page x:Class="LakberendezesAdmin.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LakberendezesAdmin.Pages"
      xmlns:converters="clr-namespace:LakberendezesAdmin.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Termékek">
    <Page.Resources>
        <converters:ShopIdToName x:Key="ShopIdToNameConverter"/>
        <converters:ProductTypeToName x:Key="ProductTypeToNameConverter"/>
        <converters:CategToName x:Key="CategToNameConverter"/>
    </Page.Resources>

    <Grid>
        <Border Background="#F9E0D9" CornerRadius="10" Padding="20" BorderBrush="#d0d0d0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Termékek"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FF333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="SearchTextBox" Width="300" Height="30" Padding="5"/>
                    <Button Content="Kereses" Width="100" Height="40" Background="#EAF7CF" Foreground="Black" Padding="5" Click="Button_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Új termék" Width="100" Height="40" Background="#EAF7CF" Foreground="Black" Padding="5" Click="Button_Click_1">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                    CornerRadius="20"
                    Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Export" Width="100" Height="40" Background="#EAF7CF" Foreground="Black" Padding="5" Click="Export_Click_2">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                   CornerRadius="20"
                                    Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid x:Name="ProductsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#BB999C"
                              GridLinesVisibility="None"
                              BorderBrush="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#f4f4f4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MaxHeight="600"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#C0E6DE"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#d0d0d0"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding id}"/>
                            <DataGridTextColumn Header="Név" Binding="{Binding name}"/>
                            <DataGridTextColumn Header="Ár" Binding="{Binding price}"/>
                            <DataGridTextColumn Header="Vásárlási link" Binding="{Binding shoplink}"/>
                            <DataGridTextColumn Header="Kép" Binding="{Binding imageurl}"/>
                            <DataGridTextColumn Header="Webáruház" Binding="{Binding shopid, Converter={StaticResource ShopIdToNameConverter}}"/>
                            <DataGridTextColumn Header="Bútor típusa" Binding="{Binding product_type_id, Converter={StaticResource ProductTypeToNameConverter}}"/>
                            <DataGridTextColumn Header="Szoba" Binding="{Binding roomid, Converter={StaticResource CategToNameConverter}}"/>
                            <DataGridTemplateColumn Header="Műveletek">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Törlés" Click="DeleteButton_Click" Tag="{Binding id}" Width="80" Height="30" Background="#C0E6DE" Foreground="Black">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="20" 
                                                            Padding="5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
