<Page x:Class="LakberendezesAdmin.Pages.SavedPlans"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LakberendezesAdmin.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="850"
      Title="Mentett tervek" Background="#E6DBD0">

	<Page.Resources>
		<DropShadowEffect x:Key="MaterialShadow"
                          BlurRadius="12"
                          ShadowDepth="4"
                          Opacity="0.4"
                          Direction="270"
                          Color="Black"/>
	</Page.Resources>
	<Grid>
		<Border Background="#F9E0D9" CornerRadius="12" Padding="20" Margin="10"
                Effect="{DynamicResource MaterialShadow}">
			<StackPanel>

				<TextBlock Text="Mentett tervek" FontSize="24" FontWeight="Bold"
                           Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
					<TextBox x:Name="SearchTextBox" Width="300" Height="30" Padding="5"/>
					<Button Content="Keresés" Width="100" Margin="10,0,0,0" Height="40" Background="#EAF7CF" Foreground="Black" Padding="5" Click="Button_Click">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="5">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<Button Content="Export" Width="100" Height="40" Background="#EAF7CF" Foreground="Black" Padding="5" Click="Export_Click_2">
						<Button.Template>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="5">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
				<DataGrid x:Name="dataGrid"
                          AutoGenerateColumns="False"
                          ColumnHeaderHeight="40"
                          RowHeight="35"
                          Background="White"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AlternatingRowBackground="#F9F9F9"
                          HorizontalGridLinesBrush="#DDD"
                          VerticalGridLinesBrush="#DDD">
					<DataGrid.Resources>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="FontSize" Value="14"/>
							<Setter Property="FontWeight" Value="Bold"/>
							<Setter Property="Background" Value="#CEB5A7"/>
							<Setter Property="Foreground" Value="Black"/>
							<Setter Property="Padding" Value="10"/>
						</Style>
					</DataGrid.Resources>
					<DataGrid.Columns>
                        <DataGridTextColumn Header="Azonosító" Binding="{Binding id}" />
                        <DataGridTextColumn Header="Felhasználó" Binding="{Binding userid}"/>
                        <DataGridTextColumn Header="Terv" Binding="{Binding plandata}" />
                        <DataGridTextColumn Header="Készült" Binding="{Binding createdat}" />
                        <DataGridTemplateColumn Header="Műveletek">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
                                    <Button Content="Törlés" Click="Delete_Click_1" Tag="{Binding id}" Width="80" Height="30" Background="#C0E6DE" Foreground="Black">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
												CornerRadius="20" 
												Padding="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</StackPanel>
		</Border>
	</Grid>
</Page>
