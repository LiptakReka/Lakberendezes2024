<Page x:Class="LakberendezesAdmin.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LakberendezesAdmin.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Felhasználók">

    <Page.Resources>

        <DropShadowEffect x:Key="TextShadowEffect" BlurRadius="3" ShadowDepth="2" Color="Black" Opacity="0.5" />

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#f0f0f0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <EventSetter Event="MouseEnter" Handler="DataGridColumnHeader_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="DataGridColumnHeader_MouseLeave"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <EventSetter Event="MouseEnter" Handler="DataGridRow_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="DataGridRow_MouseLeave"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Gray" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e9e9e9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Image Grid.RowSpan="2" Stretch="UniformToFill" Source="../assets/hatter.jpg"/>

        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="Felhasználók"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#463F1A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Effect="{StaticResource TextShadowEffect}"/>


            <TextBox x:Name="SearchTextBox"
                     Width="300"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,20"
                     Padding="5,5,25,5"
                     FontSize="16"
                     FontFamily="Segoe UI"
                     Foreground="#333"
                     Background="White"
                     BorderThickness="1"
                     BorderBrush="#ccc"
                     ToolTip="Keresés felhasználónév alapján..."
                     >

                <TextBox.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="Gray" Opacity="0.3"/>
                </TextBox.Effect>
            </TextBox>
            <Button x:Name="btnKeres" Content="Keresés" Margin="380,-54,-10,20" Width="80" Height="28" Click="btnKeres_Click"  Background="#EAF7CF" BorderBrush="#FF040404" Foreground="#FF0E0C0C">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10">
            <DataGrid x:Name="UsersGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      Background="White"
                      GridLinesVisibility="None"
                      BorderBrush="Transparent"
                      RowBackground="White"
                      AlternatingRowBackground="#f9f9f9"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MaxHeight="600"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      Margin="10"
                      Padding="5"
                      RowHeight="40"
                      ColumnHeaderHeight="45">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azonosító" Binding="{Binding Id}"  />
                    <DataGridTextColumn Header="Email-cím" Binding="{Binding Email}" />
                    <DataGridTextColumn Header="Teljes neve" Binding="{Binding fullname}" />
                    <DataGridTextColumn Header="Regisztráció dátuma" Binding="{Binding datet}" />
                    <DataGridTextColumn Header="Hozzáférés megtagadva" Binding="{Binding AccessFailedCount}" />
                    <DataGridTextColumn Header="Konkurencia bélyeg" Binding="{Binding ConcurrencyStamp}" />
                    <DataGridTextColumn Header="Email megerősítése" Binding="{Binding EmailConfirmed}" />
                    <DataGridTextColumn Header="Kizárás engedélyezve" Binding="{Binding LocoutEnabled}" />
                    <DataGridTextColumn Header="Kizárás vége" Binding="{Binding LockoutEnd}" />
                    <DataGridTextColumn Header="Email normalizálva" Binding="{Binding NormalizedEmail}" />
                    <DataGridTextColumn Header="Felhasználónév normalizálva" Binding="{Binding NormalizedUserName}" />
                    <DataGridTextColumn Header="Jelszó" Binding="{Binding PasswordHash}" />
                    <DataGridTextColumn Header="Telefonszám" Binding="{Binding PhoneNumber}" />
                    <DataGridTextColumn Header="Telefonszám megerősítve" Binding="{Binding PhoneNumberConfirmed}" />
                    <DataGridTextColumn Header="Biztonsági kód" Binding="{Binding SecurityStamp}" />
                    <DataGridTextColumn Header="Két faktoros hitelesítés" Binding="{Binding TwoFactorEnabled}" />
                    <DataGridTextColumn Header="Felhasználónév" Binding="{Binding UserName}" />
                    <DataGridTextColumn Header="Profilkép" Binding="{Binding ProfilePictureUrl}" />
                </DataGrid.Columns>
                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EAF7CF"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderBrush" Value="#ccc"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <EventSetter Event="MouseEnter" Handler="DataGridColumnHeader_MouseEnter"/>
                        <EventSetter Event="MouseLeave" Handler="DataGridColumnHeader_MouseLeave"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#ddd"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <EventSetter Event="MouseEnter" Handler="DataGridRow_MouseEnter"/>
                        <EventSetter Event="MouseLeave" Handler="DataGridRow_MouseLeave"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Gray" Opacity="0.2"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#e9e9e9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Page>
